{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_NAME}}",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "d1_databases": [
    {
      "binding": "OPENLY",
      "database_name": "{{DB_NAME}}",
      "database_id": "{{DB_DATABASE_ID}}"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PENDING",
      "id": "{{KV_NAMESPACE_ID}}"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
