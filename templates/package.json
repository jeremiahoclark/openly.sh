{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 execute {{DB_NAME}} --remote --file=src/schema.sql && wrangler deploy",
    "db:migrate": "wrangler d1 execute {{DB_NAME}} --remote --file=src/schema.sql",
    "db:migrate:local": "wrangler d1 execute {{DB_NAME}} --local --file=src/schema.sql",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "wrangler": "^4",
    "typescript": "^5"
  }
}
