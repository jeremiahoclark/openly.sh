{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openly",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "OPENLY",
      "database_name": "openly-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PENDING"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
