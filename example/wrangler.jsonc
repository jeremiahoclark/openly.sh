{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openly",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "d1_databases": [
    {
      "binding": "OPENLY",
      "database_name": "openly-db",
      "database_id": ""
    }
  ]
}
